generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String
  password             String
  /// "superadmin", "admin", "manager" or "member". A super admin has every
  /// admin permission plus the Base Price menu; see lib/roles.ts.
  role                 String             @default("member")
  /// One of SECTOR_OPTIONS in lib/designations.ts.
  sector               String?
  /// One of DESIGNATION_OPTIONS in lib/designations.ts, and part of `sector`
  /// unless it is "Intern", which fits any sector or none.
  designation          String?
  createdAt           DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teamId               String?
  activityLogs         ActivityLog[]
  announcementsCreated Announcement[]
  clientsCreated       Client[]
  attendanceRecords    AttendanceRecord[]
  dailyUpdates         DailyUpdate[]
  feedbackSubmissions  FeedbackSubmission[]
  learnings            Learning[]
  notifications        Notification[]
  moduleReviews        ModuleReview[]
  pushSubscriptions    PushSubscription[]
  researchDocs         ResearchDocument[]
  tasks                Task[]             @relation("AssignedTasks")
  taskWatches          TaskWatcher[]
  taskTimeLogs         TaskTimeLog[]
  taskReopens          TaskReopen[]
  toolUsages           ToolUsage[]
  clientSops           ClientSop[]
  documentations       Documentation[]
  documentationImages  DocumentationImage[]
  documentationAttachments DocumentationAttachment[]
  calendarEvents       CalendarEvent[]
  team                Team?              @relation(fields: [teamId], references: [id])

  @@index([teamId], map: "User_teamId_fkey")
  @@unique([email, role])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  members     User[]
}

model Client {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  /// Who owns the client relationship: an employee's name, picked on the client
  /// form. Kept as text, so a name saved before the picker stays as it was.
  owner         String?
  /// Who handles day-to-day communication with the client. Same as owner.
  communicationPerson String?
  email         String?
  phone         String?
  /// Legacy flat service list, superseded by the ClientService rows below.
  /// Kept only so pre-existing clients can seed the edit form once; new writes
  /// go to ClientService. Do not read it for payment or task mapping.
  services      String?  @db.Text
  status        String   @default("Active")
  notes         String?  @db.Text
  /// The SOP written in the editor on the client form, as HTML sanitised on
  /// save (lib/documentation.ts). Null when none was written.
  sopContent    String?  @db.LongText
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tasks         Task[]
  serviceMappings ClientService[]
  /// The file uploaded alongside the SOP, if any.
  sop           ClientSop?

  @@index([createdById], map: "Client_createdById_fkey")
  @@index([status])
}

/// The file uploaded with a client's SOP, from the client form's File Upload
/// field (the SOP's text is Client.sopContent). Kept in its own table rather
/// than as a column on Client so listing clients never drags the file's bytes
/// along. Served by app/api/clients/[id]/sop.
model ClientSop {
  id           String   @id @default(cuid())
  clientId     String   @unique
  /// The name it was uploaded with, used when it is downloaded again.
  fileName     String
  /// Decided from the file extension (lib/uploads.ts), never the browser's word.
  mimeType     String
  /// Bytes, for showing the size without loading the file.
  size         Int
  data         Bytes
  /// Null once the uploader's account is deleted; the SOP stays with the client.
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById], map: "ClientSop_uploadedById_fkey")
}

/// One service a client is engaged for, plus how that service is billed.
/// Payment type is per row, so a client can be per-count on Video Editing and
/// percentage-based on Digital Marketing at the same time. Which types a
/// service allows is decided by paymentTypesForService in lib/services.ts:
/// percentage is Digital Marketing only, per count is Video Editing only.
model ClientService {
  id            String   @id @default(cuid())
  clientId      String
  /// One of SERVICE_OPTIONS in lib/services.ts.
  service       String
  /// Focus area, currently only used by Digital Marketing (e.g. "Google Ads").
  focus         String?
  /// "Percentage", "Package", "Per count", or "Included" (Client Management,
  /// which carries no payment).
  paymentType   String
  /// Set when paymentType is "Percentage". Percent, not a fraction: 20 = 20%.
  /// Rows predating the Digital-Marketing-only rule may hold one on any service.
  percentage    Decimal? @db.Decimal(5, 2)
  /// Set when paymentType is "Package". Amount in INR.
  packageAmount Decimal? @db.Decimal(12, 2)
  /// Set when paymentType is "Per count". Rate in INR for one delivered item.
  perUnitAmount Decimal? @db.Decimal(12, 2)
  /// Set when paymentType is "Package": "Monthly" or "One-time".
  billingCycle  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, service])
  @@index([clientId], map: "ClientService_clientId_fkey")
}

/// Hourly base price for one service when the work is done by an employee of
/// a given designation in a given domain. Managed by super admins only.
model BasePrice {
  id          String   @id @default(cuid())
  /// One of SERVICE_OPTIONS in lib/services.ts.
  service     String
  /// One of SECTOR_OPTIONS in lib/designations.ts, shown as "Domain". Needed
  /// in the key because every domain has its own Intern.
  sector      String
  /// One of the sector's designations in lib/designations.ts.
  designation String
  /// Amount in INR for one hour of work.
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([service, sector, designation])
}

model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("pending")
  priority     String   @default("medium")
  assignedToId String?
  teamId       String?
  clientId     String?
  /// One of the parent client's services, stored exactly as it appears in
  /// Client.services, focus area included (e.g. "Digital Marketing (SEO)").
  clientWork   String?
  /// Amount in INR for a Digital Marketing task. Other work types leave this blank.
  digitalMarketingAmount Decimal? @db.Decimal(12, 2)
  /// Effort weight for a Video Editing task, one of VIDEO_WEIGHTAGE_OPTIONS in
  /// lib/services.ts (1 to 6 in half steps). Other work types leave this blank.
  videoWeightage Decimal? @db.Decimal(3, 1)
  /// How many posters a Poster Design task covers. Other work types leave this blank.
  posterCount  Int?
  /// How many times this task has been reopened after being completed. It is
  /// also the cycle that new time logs are stamped with, so 0 means the task is
  /// still on its original run.
  reopenCount  Int      @default(0)
  /// When the task was first completed. Locked once set: reopening and
  /// completing the rework leave it alone.
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedTo   User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  team         Team?    @relation(fields: [teamId], references: [id])
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeLogs     TaskTimeLog[]
  reopens      TaskReopen[]
  watchers     TaskWatcher[]

  @@index([assignedToId], map: "Task_assignedToId_fkey")
  @@index([teamId], map: "Task_teamId_fkey")
  @@index([clientId], map: "Task_clientId_fkey")
}

/// Someone following a task they are not assigned to. A watcher sees the task
/// in the Watching section of their dashboard and may log time on it, but does
/// not own its status -- that stays with the assignee.
model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId], map: "TaskWatcher_userId_fkey")
}

/// One stretch of work logged against a task. A task accumulates many of
/// these, so the total time spent is the sum of its logs rather than a single
/// overwritten field, and it stays clear who spent what.
model TaskTimeLog {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  /// Whole minutes, so totals stay exact -- no float rounding drift.
  minutes   Int
  /// The day the work happened, which need not be the day it was logged.
  date      DateTime
  /// Which run of the task this time belongs to: 0 for the original work, 1 for
  /// work done after the first reopen, and so on. Reopen hours total on their
  /// own from this without dropping out of the task's grand total.
  reopenCycle Int     @default(0)
  /// Free text on the original run. Required once reopenCycle is above 0 --
  /// rework has to say what it was for.
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "TaskTimeLog_taskId_fkey")
  @@index([userId], map: "TaskTimeLog_userId_fkey")
  @@index([date])
}

/// One reopening of a completed task. Kept as rows rather than a bare counter
/// so the reports can say when each reopen happened and who sent the task back,
/// and so the cycle numbers line up with TaskTimeLog.reopenCycle.
model TaskReopen {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  /// 1 for the first reopen, 2 for the second. Matches the reopenCycle stamped
  /// on every time log recorded while that cycle was open.
  cycle     Int
  /// Why the task was sent back. Optional, because a status edit from the task
  /// form has nowhere to ask for one.
  reason    String?  @db.Text
  /// Whose side it was: "client" or "team", one of REOPEN_CAUSES in
  /// lib/taskStatus.ts. Null for reopens from the task form, and for those
  /// recorded before the question was asked.
  cause     String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, cycle])
  @@index([taskId], map: "TaskReopen_taskId_fkey")
  @@index([userId], map: "TaskReopen_userId_fkey")
}

model DailyUpdate {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  todaysTasks    String   @map("workedOn") @db.Text
  completedTasks String?  @db.Text
  blockers       String?  @db.Text
  tomorrowPlan   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "DailyUpdate_userId_fkey")
}

model Learning {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String
  category      String
  referenceLink String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Learning_userId_fkey")
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String
  toolName  String
  category  String
  purpose   String
  timeSpent String
  outcome   String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ToolUsage_userId_fkey")
}

model ResearchDocument {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  category    String
  fileUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ResearchDocument_userId_fkey")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ActivityLog_userId_fkey")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  important Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
  @@index([expiresAt])
}

model ModuleReview {
  id         String   @id @default(cuid())
  userId     String
  module     String
  reviewedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById], map: "Announcement_createdById_fkey")
}

model FeedbackSubmission {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  description   String   @db.Text
  priority      String   @default("Medium")
  status        String   @default("Open")
  adminResponse String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
}

model AttendanceRecord {
  id                    String    @id @default(cuid())
  userId                String
  date                  DateTime
  scheduledStartTime    String    @default("09:00")
  /// The first check-in of the day. Later check-ins live on the sessions.
  actualCheckInTime     DateTime?
  scheduledEndTime      String    @default("18:00")
  /// The latest check-out of the day, cleared while a session is open again.
  actualCheckOutTime    DateTime?
  status                String    @default("Pending")
  lateDurationMinutes   Int?
  earlyDepartureMinutes Int?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions              AttendanceSession[]

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

/// One stretch of work inside a day: a check-in and, once it has happened, the
/// check-out that closed it. A day can hold any number of them -- stepping out
/// for lunch or a client visit and coming back is a new session, not an edit.
model AttendanceSession {
  id           String           @id @default(cuid())
  attendanceId String
  checkInTime  DateTime
  /// Null while the person is still checked in.
  checkOutTime DateTime?
  createdAt    DateTime         @default(now())
  attendance   AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

/// A page in the Documentation menu: a heading and a body written in CKEditor.
/// Every signed-in user can read every page; its author and admins can edit or
/// delete it.
model Documentation {
  id          String   @id @default(cuid())
  title       String
  /// HTML from the editor, sanitised on save (lib/documentation.ts). Images in
  /// it point at /api/documentation/images/<id>, served from DocumentationImage.
  content     String   @db.LongText
  /// Null once the author's account is deleted: the page outlives them, and
  /// from then on only admins can edit it.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachment  DocumentationAttachment?

  @@index([createdById], map: "Documentation_createdById_fkey")
}

/// The one file a documentation page can carry, of any type: an image or a
/// PDF opens in the browser, anything else downloads. Its own table, like
/// ClientSop, so listing pages never loads the bytes. Served by
/// app/api/documentation/[id]/attachment.
model DocumentationAttachment {
  id              String        @id @default(cuid())
  documentationId String        @unique
  fileName        String
  /// Decided on upload (lib/uploads.ts), never the browser's word.
  mimeType        String
  size            Int
  data            Bytes
  /// Null once the uploader's account is deleted; the file stays on the page.
  uploadedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  documentation   Documentation @relation(fields: [documentationId], references: [id], onDelete: Cascade)
  uploadedBy      User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById], map: "DocumentationAttachment_uploadedById_fkey")
}

/// An image uploaded from the documentation editor. Stored in the database, not
/// on disk, because a redeploy on the host replaces the app's files.
model DocumentationImage {
  id           String   @id @default(cuid())
  /// Read from the file's own bytes on upload (lib/uploads.ts).
  mimeType     String
  size         Int
  data         Bytes
  /// Null once the uploader's account is deleted; pages showing it keep it.
  uploadedById String?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById], map: "DocumentationImage_uploadedById_fkey")
}

/// An entry on the dashboard calendar: a meeting, a client meeting, a training
/// session, or anything else someone wants noted against a day. A private
/// entry is seen by its author alone; a shared one by everyone, and admins can
/// change or delete it too (canManageCalendarEvent in lib/calendar.ts).
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  /// One of CALENDAR_EVENT_TYPES in lib/calendar.ts.
  type        String
  /// The day it falls on. A DATE column, so no time zone can move it.
  date        DateTime @db.Date
  /// "HH:MM" on the office clock. Null for an all-day entry.
  startTime   String?
  /// "HH:MM", later than startTime. Only ever set alongside it.
  endTime     String?
  notes       String?  @db.Text
  /// "private" or "everyone", one of CALENDAR_VISIBILITIES in lib/calendar.ts.
  visibility  String   @default("private")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([createdById], map: "CalendarEvent_createdById_fkey")
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpointHash String   @unique
  endpoint     String   @db.Text
  p256dh       String   @db.Text
  auth         String   @db.Text
  userAgent    String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
