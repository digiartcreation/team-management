generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String
  password             String
  role                 String             @default("member")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teamId               String?
  activityLogs         ActivityLog[]
  announcementsCreated Announcement[]
  clientsCreated       Client[]
  attendanceRecords    AttendanceRecord[]
  dailyUpdates         DailyUpdate[]
  feedbackSubmissions  FeedbackSubmission[]
  learnings            Learning[]
  notifications        Notification[]
  moduleReviews        ModuleReview[]
  pushSubscriptions    PushSubscription[]
  researchDocs         ResearchDocument[]
  tasks                Task[]             @relation("AssignedTasks")
  toolUsages           ToolUsage[]
  team                 Team?              @relation(fields: [teamId], references: [id])

  @@index([teamId], map: "User_teamId_fkey")
  @@unique([email, role])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  members     User[]
}

model Client {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  /// Legacy flat service list, superseded by the ClientService rows below.
  /// Kept only so pre-existing clients can seed the edit form once; new writes
  /// go to ClientService. Do not read it for payment or task mapping.
  services      String?  @db.Text
  status        String   @default("Active")
  notes         String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tasks         Task[]
  serviceMappings ClientService[]

  @@index([createdById], map: "Client_createdById_fkey")
  @@index([status])
}

/// One service a client is engaged for, plus how that service is billed.
/// Payment type is per row, so a client can be percentage-based on Video
/// Editing and package-based on Digital Marketing at the same time.
model ClientService {
  id            String   @id @default(cuid())
  clientId      String
  /// One of SERVICE_OPTIONS in lib/services.ts.
  service       String
  /// Focus area, currently only used by Digital Marketing (e.g. "Google Ads").
  focus         String?
  /// "Percentage" or "Package".
  paymentType   String
  /// Set when paymentType is "Percentage". Percent, not a fraction: 20 = 20%.
  percentage    Decimal? @db.Decimal(5, 2)
  /// Set when paymentType is "Package". Amount in INR.
  packageAmount Decimal? @db.Decimal(12, 2)
  /// Set when paymentType is "Package": "Monthly" or "One-time".
  billingCycle  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, service])
  @@index([clientId], map: "ClientService_clientId_fkey")
}

model Task {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("pending")
  priority     String   @default("medium")
  assignedToId String?
  teamId       String?
  clientId     String?
  /// One of the parent client's services, stored exactly as it appears in
  /// Client.services, focus area included (e.g. "Digital Marketing (SEO)").
  clientWork   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedTo   User?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  team         Team?    @relation(fields: [teamId], references: [id])
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([assignedToId], map: "Task_assignedToId_fkey")
  @@index([teamId], map: "Task_teamId_fkey")
  @@index([clientId], map: "Task_clientId_fkey")
}

model DailyUpdate {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  todaysTasks    String   @map("workedOn") @db.Text
  completedTasks String?  @db.Text
  blockers       String?  @db.Text
  tomorrowPlan   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "DailyUpdate_userId_fkey")
}

model Learning {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String
  category      String
  referenceLink String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Learning_userId_fkey")
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String
  toolName  String
  category  String
  purpose   String
  timeSpent String
  outcome   String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ToolUsage_userId_fkey")
}

model ResearchDocument {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  category    String
  fileUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ResearchDocument_userId_fkey")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  entityType  String
  entityId    String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ActivityLog_userId_fkey")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  important Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
  @@index([expiresAt])
}

model ModuleReview {
  id         String   @id @default(cuid())
  userId     String
  module     String
  reviewedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  createdById String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById], map: "Announcement_createdById_fkey")
}

model FeedbackSubmission {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  description   String   @db.Text
  priority      String   @default("Medium")
  status        String   @default("Open")
  adminResponse String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
}

model AttendanceRecord {
  id                    String    @id @default(cuid())
  userId                String
  date                  DateTime
  scheduledStartTime    String    @default("09:00")
  actualCheckInTime     DateTime?
  scheduledEndTime      String    @default("18:00")
  actualCheckOutTime    DateTime?
  status                String    @default("Pending")
  lateDurationMinutes   Int?
  earlyDepartureMinutes Int?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpointHash String   @unique
  endpoint     String   @db.Text
  p256dh       String   @db.Text
  auth         String   @db.Text
  userAgent    String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
